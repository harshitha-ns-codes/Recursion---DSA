class Solution {
public:
vector<int> Bellman(vector<vector<int>>&edges , int src , int V)
{
    vector<int>dist(V,1e9);
    dist[src]=0
 for(int i=0;i<V-1;i++)
 {
    for(auto it : edges)
    {
        int u = it[0];
        int v = it[1];
        int wt = it[2];

        if(dist[u] != 1e9 && dist[u]+wt < dist[v])
        {
            dist[v] = dist[u]+wt;
        }
    }
}
for(auto it : edges)
    {
        int u = it[0];
        int v = it[1];
        int wt = it[2];

        if(dist[u] != 1e9 && dist[u]+wt < dist[v])
        {
            return {-1};
        }
    }
    return dist;

}
};
    
