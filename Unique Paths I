class Solution {
private:
    long long f(long long i, long long j, vector<vector<long long>>& dp)
    {
        if(i < 0 || j < 0)
            return 0;
        if(i == 0 && j == 0)
            return 1;

        // 3. Already calculated
        if(dp[i][j] != -1)
            return dp[i][j];

        long long up = f(i - 1, j, dp);
        long long left = f(i, j - 1, dp);

        return dp[i][j] = up + left;
    }

public:
    int uniquePaths(int m, int n)
    {
        vector<vector<long long>> dp(
            m, vector<long long>(n, -1)
        );

        return f(m - 1, n - 1, dp);
    }
};

class Solution {
public:
    int uniquePaths(int m, int n)
    {
        vector<vector<long long>> dp(
            m, vector<long long>(n, 0)
        );

        for(int i = 0; i < m; i++)
        {
            for(int j = 0; j < n; j++)
            {
                if(i == 0 && j == 0)
                {
                    dp[i][j] = 1;
                    continue;
                }

                long long up = 0;
                long long left = 0;

                if(i > 0)
                    up = dp[i-1][j];

                if(j > 0)
                    left = dp[i][j-1];

                dp[i][j] = up + left;
            }
        }

        return dp[m-1][n-1];
    }
};
