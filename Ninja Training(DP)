#include <bits/stdc++.h>
using namespace std;

//Memoization
int f(int day, int last , vector<vector<int>>&tasks ,vector<vector<int>>&dp)
{
    if(dp[day][last] != -1) return dp[day][last];
    int maxi =0;
    if(day == 0)
    {
        for(int i=0;i<=2;i++)
        {
            if(i != last){
                maxi = max(maxi, tasks[0][i]);
            }
        }
        return maxi;
    }
    maxi =0;
    for(int i=0;i<=2;i++){
        if(i != last){
            int points = tasks[day][i]+f(day-1,i,tasks,dp);
            maxi = max(maxi,points);
        }
    }
    return dp[day][last] = maxi;
}
int ninjaTraining(int n, vector<vector<int>> &tasks) 
{
    int n = tasks.size();
    int m = tasks[0].size();
    vector<vector<int>>dp(n,vector<int>(4,-1));
    return f(n-1,3,tasks,dp);
}

//Tabulation
int ninjaTraining(int n , vector<vector<int>>&tasks)
{
    vector<vector<int>>dp(n,vector<int>(4,0));
    int maxi=0;
    for(int last=0;last<=3;last++)
    {
        for(int i=0;i<=2;i++)
        {
            if(i != last){
                maxi = max(maxi,tasks[0][i]);
            }
            
        }
        dp[0][last]=maxi;
    }

    for(int day=1;day<n;day++){
        for(int last=0;last<=3;last++){
            maxi =0;
            for(int i=0;i<=2;i++){
                if(i != last){
                int points=tasks[day][i]+dp[day-1][i];
                maxi = max(maxi,points);

            }
        }
        dp[day][last]=maxi;
        }
        
    }
    return dp[n-1][3];
}

