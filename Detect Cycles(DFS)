class Solution {
private:
bool dfs(int node , int parent , vector<int>&vis , vector<vector<int>>&adjLs)
{
    vis[node]=1;
    for(auto it : adjLs[node])
    {
        if(vis[it]==0)
        {
            if(dfs(it,node,vis,adjLs)==true)
            {
                return true;
            }
        }
        else if(parent != it)
        {
            return true;
        }
    }
    return false;
}
