class Solution {
private:
void dfs(int r , int c , vector<vector<int>>&vis ,vector<vector<char>>& board,int delR[],int delC[])
{
    int n = board.size();
    int m = board[0].size();
    vis[r][c]=1;
    for(int i=0;i<4;i++)
    {
        int nRow = r+delR[i];
        int nCol = c+delC[i];
        if(nRow>=0 && nRow < n && nCol >=0 && nCol < m && vis[nRow][nCol] == 0 && board[nRow][nCol]=='O')
        {
            dfs(nRow,nCol,vis,board,delR,delC);
        }
    }
}
public:
    void solve(vector<vector<char>>& board) 
    {
        int n = board.size();
        int m = board[0].size();
        vector<vector<int>>vis(n,vector<int>(m,0));
        int delR[] = {-1,0,+1,0};
        int delC[] = {0,+1,0,-1};
        // traverse the 1st row
        for(int j=0;j<m;j++)
        {
            if(board[0][j] == 'O' && vis[0][j] == 0)
            {
                dfs(0,j,vis,board,delR,delC);
            }
        }
        // traverse the last row
        for(int j=0;j<m;j++)
        {
            if(board[n-1][j] == 'O' && vis[n-1][j] == 0)
            {
                dfs(n-1,j,vis,board,delR,delC);
            }
        }
        //traverse for 1st col
        for(int i=0;i<n;i++)
        {
            if(board[i][0] == 'O' && vis[i][0] == 0)
            {
                dfs(i,0,vis,board,delR,delC);
            }
        }
        //traverse for last col
        for(int i=0;i<n;i++)
        {
            if(board[i][m-1] == 'O' && vis[i][m-1] == 0)
            {
                dfs(i,m-1,vis,board,delR,delC);
            }
        }
        for(int i=0;i<n;i++)
        {
            for(int j=0;j<m;j++)
            {
                if(vis[i][j] == 0 && board[i][j] == 'O')
                {
                    board[i][j]='X';
                }
            }

        }
        if(board.empty()) return;
        
    }
};
