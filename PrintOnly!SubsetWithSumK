#include <iostream>
#include <vector>
using namespace std;

bool PrintS(int ind, vector<int>& ds, int s, int sum, int arr[], int n){

    if(ind == n){
        if(s == sum){
            for(int i = 0; i < ds.size(); i++){
                cout << ds[i] << " ";
                
            }
            cout << endl;
            return true;
            
        }
        return false ;
    }

    // pick the element
    ds.push_back(arr[ind]);
    s += arr[ind];

    if(PrintS(ind + 1, ds, s, sum, arr, n) == true ) return true;

    // undo the pick
    s -= arr[ind];
    ds.pop_back();

    // not pick
    if(PrintS(ind + 1, ds, s, sum, arr, n) == true) return true;

return false;
}

int main(){

    int arr[] = {1,2,1};
    int n = 3;
    int sum = 2;

    vector<int> ds;

    PrintS(0, ds, 0, sum, arr, n);

    return 0;
}
