class Solution {
private:
    int timer = 1;

    void dfs(int node, int parent,
             vector<int>& vis,
             vector<int> adj[],
             int tin[],
             int low[],
             vector<int>& mark) {

        vis[node] = 1;

        // Discovery time and low time
        tin[node] = low[node] = timer;
        timer++;

        int child = 0;

        for (auto it : adj[node]) {

            // Ignore the edge through which we came
            if (it == parent)
                continue;

            // DFS child
            if (vis[it] == 0) {

                dfs(it, node, vis, adj, tin, low, mark);

                // Update low[node] using child's low value
                low[node] = min(low[node], low[it]);

                // Articulation point condition
                if (low[it] >= tin[node] && parent != -1) {
                    mark[node] = 1;
                }

                child++;
            }

            // Already visited neighbour (back edge)
            else {
                low[node] = min(low[node], tin[it]);
            }
        }

        // Special case for root node
        if (parent == -1 && child > 1) {
            mark[node] = 1;
        }
    }

public:
    vector<int> articulationPoints(int V, vector<int> adj[]) {

        vector<int> vis(V, 0);
        vector<int> mark(V, 0);

        int tin[V];
        int low[V];

        // In case graph is disconnected
        for (int i = 0; i < V; i++) {
            if (vis[i] == 0) {
                dfs(i, -1, vis, adj, tin, low, mark);
            }
        }

        vector<int> ans;

        for (int i = 0; i < V; i++) {
            if (mark[i] == 1) {
                ans.push_back(i);
            }
        }

        if (ans.size() == 0)
            return {-1};

        return ans;
    }
};
