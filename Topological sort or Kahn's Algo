class Solution {
private:
void  dfs(int node , stack<int>&st , vector<int>&vis , vector<vector<int>>&adjLs)
{
    vis[node]=1;
    for(auto it : adjLs[node])
    {
        if(vis[it]==0)
        {
            dfs(it,st,vis,adjLs);
            
        }
        st.push(node);
    }
public:
vector<int> topo(int V , vector<vector<int>>&adjLs)
{
    vector<int>vis(V,0);
    stack<int>st;
    for(int i=0;i<V;i++)
    {
        if(vis[i] == 0)
        {
        dfs(i,st,vis,adjLs);
        }
    }
    vector<int>ans;
    while(!st.empty())
    {
        ans.push_back(st.top());
        st.pop();
    }
    return ans;
}
};
