#include <bits/stdc++.h>
using namespace std;

class DisjointSet {
    vector<int> parent, size;

public:
    DisjointSet(int n) {
        parent.resize(n + 1);
        size.resize(n + 1, 1);

        for (int i = 0; i <= n; i++) {
            parent[i] = i;
        }
    }

    int findUPar(int node) {
        if (node == parent[node]) {
            return node;
        }

        return parent[node] = findUPar(parent[node]);
    }

    void unionBySize(int u, int v) {
        int ultimateParentU = findUPar(u);
        int ultimateParentV = findUPar(v);

        // Already part of the same component
        if (ultimateParentU == ultimateParentV) {
            return;
        }

        // Attach smaller component to larger component
        if (size[ultimateParentU] < size[ultimateParentV]) {
            parent[ultimateParentU] = ultimateParentV;
            size[ultimateParentV] += size[ultimateParentU];
        }
        else {
            parent[ultimateParentV] = ultimateParentU;
            size[ultimateParentU] += size[ultimateParentV];
        }
    }
};


class Solution {

private:

    bool isValid(int row, int col, int n, int m) {
        return row >= 0 && row < n &&
               col >= 0 && col < m;
    }

public:

    vector<int> numOfIslands(
        int n,
        int m,
        vector<vector<int>>& operators
    ) {

        // DSU for all cells
        DisjointSet ds(n * m);

        // 0 = water, 1 = land
        vector<vector<int>> vis(n, vector<int>(m, 0));

        int cnt = 0;

        vector<int> ans;

        for (auto it : operators) {

            int row = it[0];
            int col = it[1];

            // If land already exists
            if (vis[row][col] == 1) {
                ans.push_back(cnt);
                continue;
            }

            // Mark as land
            vis[row][col] = 1;

            // Initially, this is a new island
            cnt++;

            // Four directions
            int dr[] = {-1, 0, 1, 0};
            int dc[] = {0, 1, 0, -1};

            for (int ind = 0; ind < 4; ind++) {

                int adjr = row + dr[ind];
                int adjc = col + dc[ind];

                // Check if adjacent cell is inside the grid
                if (isValid(adjr, adjc, n, m)) {

                    // Check if adjacent cell is land
                    if (vis[adjr][adjc] == 1) {

                        // Convert current cell to DSU node
                        int nodeNo = row * m + col;

                        // Convert adjacent cell to DSU node
                        int adjNodeNo = adjr * m + adjc;

                        // Merge only if they belong
                        // to different components
                        if (ds.findUPar(nodeNo) !=
                            ds.findUPar(adjNodeNo)) {

                            ds.unionBySize(nodeNo, adjNodeNo);

                            // Two islands became one
                            cnt--;
                        }
                    }
                }
            }

            // Store number of islands after this operation
            ans.push_back(cnt);
        }

        return ans;
    }
};
