class Solution{
private:
int f(int ind , int sum , vector<int>&arr,vector<vector<int>>&dp)
{
    if(sum == 0) return 1;
    if(ind == 0) return (arr[0]==sum);
    if(dp[ind][sum] != -1) return dp[ind][sum];
    int notTaken = f(ind-1,sum,arr,dp);
    int taken=0;
    if(sum >= arr[ind]){
        taken = f(ind-1,sum-arr[ind],arr,dp);
    }
    return dp[ind][sum]=taken+notTaken;
}
public:
int SunsetK(int n , int k , vector<int>&arr)
{
    vector<vector<int>>dp(n,vector<int>(k+1,-1));
    return f(n-1,k,arr,dp);
}
}

//Tabulation
class Solution {
public:
    int subsetSumToK(int n, int k, vector<int>& arr)
    {
        vector<vector<int>> dp(
            n,
            vector<int>(k + 1, 0)
        );

        // Target = 0 is always possible
        for(int ind = 0; ind < n; ind++)
        {
            dp[ind][0] = 1;
        }

        // First element
        if(arr[0] <= k)
        {
            dp[0][arr[0]] = 1;
        }

        // Fill remaining rows
        for(int ind = 1; ind < n; ind++)
        {
            for(int sum = 1; sum <= k; sum++)
            {
                // Don't take arr[ind]
                int notTaken = dp[ind-1][sum];

                // Take arr[ind]
                int taken = 0;

                if(arr[ind] <= sum)
                {
                    taken = dp[ind-1][sum - arr[ind]];
                }

                dp[ind][sum] = taken + notTaken;
            }
        }

        return dp[n-1][k];
    }
};
