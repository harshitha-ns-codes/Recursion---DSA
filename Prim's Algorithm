class Solution {
public:
int prims(vector<vector<int>>adjLs[],int V)
{
    priority_queue<pair<int,int>,
    vector<pair<int,int>>,
    greater<pair<int,int>>>pq;
    vector<int>vis(V,0);
    int sum =0;
    pq.push({0,0});
    while(!pq.empty())
    {
        auto it = pq.top();
        pq.pop();
        int wt = it.first;
        int node = it.second;
        if(vis[node] == 1) continue;
        vis[node]=1;
        sum+=wt;
        for(auto it : adjLs[node])
        {
            int adjNode = it[0];
            int edgeWt = it[1];
            if(vis[adjNode] == 0){
                pq.push({edgeWt,adjNode});
            }
        }
    }
    return sum;

}
};
    
