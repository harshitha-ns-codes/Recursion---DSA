#include <iostream>
using namespace std;
void dfs(int node , vector<int>&visi,vector<int>adj[])
{
    visi[node]=1;
    for(auto it : adj[node])
    {
        if(visi[it] == 0)
        {
            dfs(it,visi,adj);
        }
    }
}
int connectedComponents(int V , vector<int>adj[])
{
    int cnt=0;
    vector<int>visi(V,0);
    for(int i=0;i<V;i++)
    {
        if(visi[i]==0)
        {
            cnt++;
            dfs(i,visi,adj);
        }
    }
    
    return cnt;
}
