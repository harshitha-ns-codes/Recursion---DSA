#include <iostream>
#include <stack>
using namespace std;

void insert(stack<int> &s, int temp)
{
    if(s.empty())
    {
        s.push(temp);
        return;
    }

    int val = s.top();
    s.pop();

    insert(s, temp);

    s.push(val);
}

void reverse(stack<int> &s)
{
    if(s.size() <= 1)
        return;

    int temp = s.top();
    s.pop();

    reverse(s);

    insert(s, temp);
}
