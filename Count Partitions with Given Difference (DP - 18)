//Memoization
#include <bits/stdc++.h>
using namespace std;

class Solution {
private:
    int f(int ind, int target, vector<int>& arr, vector<vector<int>>& dp) {
        
        // Base case
        if (ind == 0) {
            if (target == 0 && arr[0] == 0)
                return 2;  // take 0 or don't take 0

            if (target == 0 || target == arr[0])
                return 1;

            return 0;
        }

        // Already calculated
        if (dp[ind][target] != -1)
            return dp[ind][target];

        // Don't take current element
        int notTake = f(ind - 1, target, arr, dp);

        // Take current element
        int take = 0;
        if (arr[ind] <= target) {
            take = f(ind - 1, target - arr[ind], arr, dp);
        }

        return dp[ind][target] = take + notTake;
    }

public:
    int countPartitions(vector<int>& arr, int d) {

        int totalSum = accumulate(arr.begin(), arr.end(), 0);

        // Impossible cases
        if (d > totalSum)
            return 0;

        if ((totalSum + d) % 2 != 0)
            return 0;

        int K = (totalSum + d) / 2;

        int n = arr.size();

        vector<vector<int>> dp(n, vector<int>(K + 1, -1));

        return f(n - 1, K, arr, dp);
    }
};

//Tabulation
#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    int countPartitions(vector<int>& arr, int d) {

        int totalSum = accumulate(arr.begin(), arr.end(), 0);

        // Impossible cases
        if (d > totalSum)
            return 0;

        if ((totalSum + d) % 2 != 0)
            return 0;

        int K = (totalSum + d) / 2;

        int n = arr.size();

        // dp[ind][target]
        // Number of ways to make 'target'
        // using elements from 0 to ind
        vector<vector<int>> dp(n, vector<int>(K + 1, 0));

        // ---------------- BASE CASE ----------------

        // Target 0 is always possible by selecting nothing
        dp[0][0] = 1;

        // If first element itself can make target
        if (arr[0] <= K) {
            dp[0][arr[0]] += 1;
        }

        // ---------------- REST OF THE TABLE ----------------

        for (int ind = 1; ind < n; ind++) {

            for (int target = 0; target <= K; target++) {

                // Don't take arr[ind]
                int notTake = dp[ind - 1][target];

                // Take arr[ind]
                int take = 0;

                if (arr[ind] <= target) {
                    take = dp[ind - 1][target - arr[ind]];
                }

                dp[ind][target] = notTake + take;
            }
        }

        return dp[n - 1][K];
    }
};
