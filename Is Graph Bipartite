class Solution {
private:
bool dfs(int node , int curColor , vector<int>&colorVis ,vector<vector<int>>& graph)
{
    colorVis[node]=curColor;
    for(auto it : graph[node])
    {
        if(colorVis[it] == -1)
        {
            if(dfs(it,!curColor,colorVis,graph)==false) return false;
        }
        else if(colorVis[it] == curColor){
            return false;
        }
    }
    return true;
}
public:
    bool isBipartite(vector<vector<int>>& graph) 
    {
        int V = graph.size();
        vector<int>colorVis(V,-1);
        for(int i=0;i<V;i++)
        {
            if(colorVis[i] == -1)
            {
                if(dfs(i,0,colorVis,graph)==false)
                {
                    return false;
                }
            }
        }
        return true;
        
    }
};
