}

//Tabulation
class Solution {
public:
    bool subsetSumToK(int n, int k, vector<int>& arr)
    {
        vector<vector<bool>> dp(
            n,
            vector<bool>(k + 1, false)
        );

        // Target = 0 is always possible
        for(int ind = 0; ind < n; ind++)
        {
            dp[ind][0] = true;
        }

        // First element
        if(arr[0] <= k)
        {
            dp[0][arr[0]] = true;
        }

        // Fill remaining rows
        for(int ind = 1; ind < n; ind++)
        {
            for(int target = 1; target <= k; target++)
            {
                // Don't take arr[ind]
                bool notTaken = dp[ind-1][target];

                // Take arr[ind]
                bool taken = false;

                if(arr[ind] <= target)
                {
                    taken = dp[ind-1][target - arr[ind]];
                }

                dp[ind][target] = taken || notTaken;
            }
        }

        return dp[n-1][k];
    }
};

//Space optimization
class Solution {
public:
    bool subsetSumToK(int n, int k, vector<int>& arr)
    {
        vector<bool> prev(k + 1, false);
        vector<bool> curr(k + 1, false);

        // Target 0 is always possible
        prev[0] = true;

        // First element
        if(arr[0] <= k)
        {
            prev[arr[0]] = true;
        }

        // Process remaining elements
        for(int ind = 1; ind < n; ind++)
        {
            curr[0] = true;

            for(int target = 1; target <= k; target++)
            {
                // Don't take
                bool notTaken = prev[target];

                // Take
                bool taken = false;

                if(arr[ind] <= target)
                {
                    taken = prev[target - arr[ind]];
                }

                curr[target] = taken || notTaken;
            }

            prev = curr;
        }

        return prev[k];
    }
};
