//Mmoization
class Solution{
private:
int f(int r,int c , int i,int j1,int j2,vector<vector<vector<int>>>&dp,vector<vector<int>>&grid)
{
    //Out of bounds
    if(j1 <0 || j1>c || j2<0 || j2>c) return -1e8;
    //Base Case
    if(i == r-1){
        if(j1 == j2) return grid[i][j1];
        else{
            return grid[i][j1]+grid[i][j2];
        }
    }
    
      if(dp[i][j1][j2] != -1)
            return dp[i][j1][j2];

        int maxi = -1e8;

        // Alice's movement
        for(int dj1 = -1; dj1 <= 1; dj1++)
        {
            // Bob's movement
            for(int dj2 = -1; dj2 <= 1; dj2++)
            {
                int value = 0;

                // If both are on same cell, count it once
                if(j1 == j2)
                    value = grid[i][j1];
                else
                    value = grid[i][j1] + grid[i][j2];

                // Move both to next row
                value += f(i + 1,
                          j1 + dj1,
                          j2 + dj2,
                          r, c, grid, dp);

                maxi = max(maxi, value);
            }
        }

        return dp[i][j1][j2] = maxi;
    }

public:
int maxChoclates(int r , int c , vector<vector<int>>&grid)
{
    vector<vector<vector<int>>>dp(r,vector<vector<int>>(c,vector<int>(c,-1)));
    return f(r,c,0,0,c-1,dp,grid);
}
};

//Tabulation
class Solution {
public:
    int maximumChocolates(int r, int c,
                          vector<vector<int>>& grid)
    {
        vector<vector<vector<int>>> dp(
            r,
            vector<vector<int>>(c, vector<int>(c, -1))
        );

        // Base case: last row
        for(int j1 = 0; j1 < c; j1++)
        {
            for(int j2 = 0; j2 < c; j2++)
            {
                if(j1 == j2)
                    dp[r-1][j1][j2] = grid[r-1][j1];
                else
                    dp[r-1][j1][j2] =
                        grid[r-1][j1] + grid[r-1][j2];
            }
        }

        // Fill from bottom to top
        for(int i = r-2; i >= 0; i--)
        {
            for(int j1 = 0; j1 < c; j1++)
            {
                for(int j2 = 0; j2 < c; j2++)
                {
                    int maxi = -1e8;

                    // Alice's movement
                    for(int dj1 = -1; dj1 <= 1; dj1++)
                    {
                        // Bob's movement
                        for(int dj2 = -1; dj2 <= 1; dj2++)
                        {
                            int nj1 = j1 + dj1;
                            int nj2 = j2 + dj2;

                            // Check boundaries
                            if(nj1 >= 0 && nj1 < c &&
                               nj2 >= 0 && nj2 < c)
                            {
                                int value;

                                if(j1 == j2)
                                    value = grid[i][j1];
                                else
                                    value = grid[i][j1]
                                          + grid[i][j2];

                                value += dp[i+1][nj1][nj2];

                                maxi = max(maxi, value);
                            }
                        }
                    }

                    dp[i][j1][j2] = maxi;
                }
            }
        }

        return dp[0][0][c-1];
    }
};

//Space Optimization
class Solution {
public:
    int maximumChocolates(int r, int c,
                          vector<vector<int>>& grid)
    {
        vector<vector<int>> next(
            c, vector<int>(c, 0)
        );

        vector<vector<int>> curr(
            c, vector<int>(c, 0)
        );

        // Base case: last row
        for(int j1 = 0; j1 < c; j1++)
        {
            for(int j2 = 0; j2 < c; j2++)
            {
                if(j1 == j2)
                    next[j1][j2] = grid[r-1][j1];
                else
                    next[j1][j2] =
                        grid[r-1][j1] + grid[r-1][j2];
            }
        }

        // Bottom to top
        for(int i = r-2; i >= 0; i--)
        {
            for(int j1 = 0; j1 < c; j1++)
            {
                for(int j2 = 0; j2 < c; j2++)
                {
                    int maxi = -1e8;

                    // 9 possible movements
                    for(int dj1 = -1; dj1 <= 1; dj1++)
                    {
                        for(int dj2 = -1; dj2 <= 1; dj2++)
                        {
                            int nj1 = j1 + dj1;
                            int nj2 = j2 + dj2;

                            if(nj1 >= 0 && nj1 < c &&
                               nj2 >= 0 && nj2 < c)
                            {
                                int value;

                                if(j1 == j2)
                                    value = grid[i][j1];
                                else
                                    value = grid[i][j1]
                                          + grid[i][j2];

                                value += next[nj1][nj2];

                                maxi = max(maxi, value);
                            }
                        }
                    }

                    curr[j1][j2] = maxi;
                }
            }

            next = curr;
        }

        return next[0][c-1];
    }
};
