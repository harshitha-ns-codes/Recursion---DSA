#include <bits/stdc++.h>
using namespace std;

void func(int ind, vector<int>& arr, vector<vector<int>>& ans){
    if(ind == arr.size()){
        ans.push_back(arr);
        return;
    }

    for(int i = ind; i < arr.size(); i++){
        swap(arr[ind], arr[i]);
        func(ind + 1, arr, ans);
        swap(arr[ind], arr[i]); // backtrack
    }
}

vector<vector<int>> permutation(vector<int>& arr){
    vector<vector<int>> ans;
    func(0, arr, ans);
    return ans;
}

int main(){
    int n;
    cout << "Enter number of elements: ";
    cin >> n;

    vector<int> arr(n);
    cout << "Enter elements:\n";
    for(int i = 0; i < n; i++){
        cin >> arr[i];
    }

    vector<vector<int>> result = permutation(arr);

    cout << "\nAll permutations:\n";
    for(auto &perm : result){
        for(auto &num : perm){
            cout << num << " ";
        }
        cout << endl;
    }

    return 0;
}
